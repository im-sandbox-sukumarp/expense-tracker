    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>im-sandbox-sukumarp.ExpenseTracker.Services</PackageId>
    <Version>1.1.0</Version>
    <Authors>im-sandbox-sukumarp</Authors>
    <Company>im-sandbox-sukumarp</Company>
    <Description>Service layer implementations for the Expense Tracker application</Description>
    <PackageTags>expense;tracker;finance;services</PackageTags>
